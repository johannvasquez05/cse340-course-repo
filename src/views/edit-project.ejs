<%- include('partials/header') %>

    <main>
        <h1>Edit <%= project.title %>
        </h1>

        <form action="/edit-project/<%= project.project_id %>" method="POST">

            <div class="form-group">
                <label for="title">Project Title:</label>
                <input type="text" id="title" name="title" value="<%= project.title %>" required>
            </div>

            <div class="form-group">
                <label for="date">Date:</label>
                <% let formattedDate='' ; if (project.date) { const d=new Date(project.date); const
                    userTimezoneOffset=d.getTimezoneOffset() * 60000; formattedDate=new Date(d.getTime() -
                    userTimezoneOffset).toISOString().split('T')[0]; } %>
                    <input type="date" id="date" name="date" value="<%= formattedDate %>" required>
            </div>

            <div class="form-group">
                <label for="location">Location:</label>
                <input type="text" id="location" name="location" value="<%= project.location %>" required>
            </div>

            <div class="form-group">
                <label for="organization_id">Partner Organization:</label>
                <select id="organization_id" name="organization_id" required>
                    <% organizations.forEach(function(org) { %>
                        <option value="<%= org.organization_id %>" <%=project.organization_id===org.organization_id
                            ? 'selected' : '' %>>
                            <%= org.name %>
                        </option>
                        <% }); %>
                </select>
            </div>

            <div class="form-group">
                <label for="description">Description:</label>
                <textarea id="description" name="description" rows="5" required><%= project.description %></textarea>
            </div>

            <button type="submit" class="btn">Save Changes</button>
        </form>
    </main>

    <%- include('partials/footer') %>