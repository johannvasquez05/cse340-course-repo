<%- include('partials/header') %>

    <main>
        <h1>
            <%= title %>
        </h1>

        <table class="users-table">
            <thead>
                <tr>
                    <th>Name</th>
                    <th>Email</th>
                    <th>Role</th>
                </tr>
            </thead>
            <tbody>
                <% users.forEach(userItem=> { %>
                    <tr>
                        <td>
                            <%= userItem.name %>
                        </td>
                        <td>
                            <%= userItem.email %>
                        </td>
                        <td>
                            <span class="role-badge role-<%= userItem.role_name %>">
                                <%= userItem.role_name %>
                            </span>
                        </td>
                    </tr>
                    <% }); %>
            </tbody>
        </table>
    </main>

    <%- include('partials/footer') %>