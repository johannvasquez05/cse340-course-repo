<%- include('partials/header') %>

    <main>
        <h1>
            <%= project.title %>
        </h1>

        <div>
            <p><strong>Date:</strong>
                <%= new Date(project.date).toLocaleDateString('en-US', { year: 'numeric' , month: 'long' ,
                    day: 'numeric' }) %>
            </p>
            <p><strong>Location:</strong>
                <%= project.location %>
            </p>
            <p><strong>Partner Organization:</strong> <a href="/organization/<%= project.organization_id %>">
                    <%= project.organization_name %>
                </a></p>

            <p><strong>Categories:</strong>
                <% if (categories && categories.length> 0) { %>
                    <% categories.forEach((category, index)=> { %>
                        <a href="/category/<%= category.category_id %>">
                            <%= category.name %>
                        </a>
                        <%= index < categories.length - 1 ? ', ' : '' %>
                            <% }); %>
                                <% } else { %>
                                    None
                                    <% } %>
                                        <% if (user && user.role_name==='admin' ) { %>
                                            <p><a class="btn" href="/assign-categories/<%= project.project_id %>">Edit
                                                    Categories</a>
                                            </p>
                                            <% } %>
            </p>

            <h2>About this Project</h2>
            <p>
                <%= project.description %>
            </p>
        </div>
        <% if (user) { %>
            <div class="volunteer-section">
                <% if (isVolunteering) { %>
                    <p>You are volunteering for this project.</p>
                    <form action="/project/<%= project.project_id %>/unvolunteer" method="POST">
                        <button type="submit" class="btn btn-warning">Remove Me as Volunteer</button>
                    </form>
                    <% } else { %>
                        <form action="/project/<%= project.project_id %>/volunteer" method="POST">
                            <button type="submit" class="btn btn-primary">Volunteer for this Project</button>
                        </form>
                        <% } %>
            </div>
            <% } %>
                <% if (user && user.role_name==='admin' ) { %>
                    <p><a class="btn" href="/edit-project/<%= project.project_id %>">Edit Project Details</a></p>
                    <% } %>
    </main>

    <%- include('partials/footer') %>